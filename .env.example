# Local development only. Use a URL-safe random value; never commit .env.
KC_POSTGRES_PASSWORD=replace-with-a-random-local-password
KC_POSTGRES_PORT=5432

# Auth0 normal sign-in: populate in the server environment, never commit real secrets.
KC_AUTH0_DOMAIN=
KC_AUTH0_CLIENT_ID=
KC_AUTH0_CLIENT_SECRET=
KC_AUTH_BROKER_DSN=
KC_WEB_DSN=
